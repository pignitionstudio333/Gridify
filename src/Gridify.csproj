<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Gridify</AssemblyName>
    <RootNamespace>GridifyApp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Gridify</Product>
    <Company>Pignition Studio</Company>
    <Authors>Pignition Studio</Authors>
    <Description>Gridify - desktop organizer for Windows</Description>
    <Copyright>Copyright (c) Pignition Studio</Copyright>
    <ApplicationIcon>assets\Gridify.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本紀錄打包進程式，離線也看得到。WithCulture=false：不要因為檔名有 zh-TW 就被拆成語系衛星資源 -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Changelog.en" />
    <EmbeddedResource Include="..\docs\CHANGELOG.zh-TW.md" LogicalName="Changelog.zh-TW" WithCulture="false" />
  </ItemGroup>

</Project>
