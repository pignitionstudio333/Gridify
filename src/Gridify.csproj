<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Gridify</AssemblyName>
    <RootNamespace>GridifyApp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Gridify</Product>
    <Company>Pignition Studio</Company>
    <Authors>Pignition Studio</Authors>
    <Description>Gridify - desktop organizer for Windows</Description>
    <Copyright>Copyright (c) Pignition Studio</Copyright>
    <ApplicationIcon>assets\Gridify.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
