<Window x:Class="GridifyApp.GridWindow"
        xmlns:l="clr-namespace:GridifyApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        MinWidth="140" MinHeight="90" Width="320" Height="240">

    <Window.Resources>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="10">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="bar" Margin="3,2" CornerRadius="2"
                                                        Background="{DynamicResource Grid.Grip}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bar" Property="Background" Value="{DynamicResource Grid.TitleText}"/>
                                                        <Setter TargetName="bar" Property="Margin" Value="2,2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightDown"/>
            <EventSetter Event="MouseEnter" Handler="Item_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Item_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="hl" CornerRadius="6" Background="{DynamicResource Grid.Hover}" Opacity="0"/>
                            <Border x:Name="sel" CornerRadius="6" Background="{DynamicResource Grid.Select}" Opacity="0"/>
                            <Border Padding="6,6,6,4">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource Grid.Bg}" BorderBrush="{DynamicResource Grid.Border}" BorderThickness="1"
            AllowDrop="True" DragEnter="Grid_DragEnter" DragLeave="Grid_DragLeave" DragOver="Grid_DragOver" Drop="Grid_Drop"
            ContextMenuOpening="Root_ContextMenuOpening" PreviewMouseWheel="Root_PreviewMouseWheel">
        <Border.ContextMenu>
            <ContextMenu Opened="Menu_Opened">
                <MenuItem Header="{l:T menu.open}" Tag="item" Click="Menu_Open" InputGestureText="Enter">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.openLocation}" Tag="item" Click="Menu_OpenLocation">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.moveOut}" Tag="moveout" Click="Menu_MoveOut">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.renameFile}" Tag="rename" Click="Menu_RenameFile" InputGestureText="F2">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.deleteFile}" Tag="delete" Click="Menu_DeleteFile" InputGestureText="Del">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T menu.collapse}" Click="Menu_ToggleCollapse" InputGestureText="{l:T menu.collapseHint}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.renameGrid}" Click="Menu_Rename">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.newGrid}" Click="Menu_New">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T menu.deleteGrid}" Tag="griddelete" Click="Menu_Delete">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T menu.newTab}" Tag="newtab" Click="Menu_NewTab"/>
                <MenuItem Header="{l:T menu.renameTab}" Tag="tabmulti" Click="Menu_RenameTab"/>
                <MenuItem Header="{l:T menu.deleteTab}" Tag="tabmulti" Click="Menu_DeleteTab"/>
                <Separator/>
                <MenuItem Header="{l:T menu.undo}" Tag="undo" Click="Menu_Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{l:T menu.redo}" Tag="redo" Click="Menu_Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="{l:T menu.iconSize}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;"/></MenuItem.Icon>
                    <MenuItem Header="{l:T size.small}" Tag="24" Click="Menu_IconSize"/>
                    <MenuItem Header="{l:T size.medium}" Tag="32" Click="Menu_IconSize"/>
                    <MenuItem Header="{l:T size.large}" Tag="48" Click="Menu_IconSize"/>
                    <MenuItem Header="{l:T size.xl}" Tag="72" Click="Menu_IconSize"/>
                </MenuItem>
                <MenuItem Header="{l:T menu.appearance}" Click="Menu_Appearance">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE790;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T menu.quit}" Click="Menu_Exit">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;"/></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" AllowDrop="True"
                  PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="TitleBar_PreviewMouseMove" PreviewMouseLeftButtonUp="TitleBar_PreviewMouseLeftButtonUp"
                  MouseEnter="TitleBar_MouseEnter" MouseLeave="TitleBar_MouseLeave">
                <TextBlock x:Name="TitleText" Margin="10,0,64,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Grid.TitleText}" FontWeight="SemiBold" FontSize="12"/>
                <!-- 只有一個分頁時：標題列右側的 +，按下去變成兩個分頁 -->
                <TextBlock x:Name="TabAddSingle" Text="+" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,30,0" Padding="8,0,8,2" Background="Transparent" Opacity="0.4" Cursor="Hand"
                           Foreground="{DynamicResource Grid.TitleText}" ToolTip="{l:T menu.newTab}"
                           MouseLeftButtonDown="TabAdd_MouseLeftButtonDown"/>
                <Grid x:Name="TabStrip" Visibility="Collapsed" Margin="4,0,34,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="TabScroll" Grid.Column="0" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                        <StackPanel x:Name="TabPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <TextBlock x:Name="TabAdd" Grid.Column="1" Text="+" FontSize="16" VerticalAlignment="Center"
                               Padding="8,0,8,2" Background="Transparent" Opacity="0.7" Cursor="Hand"
                               Foreground="{DynamicResource Grid.TitleText}" ToolTip="{l:T menu.newTab}"
                               MouseLeftButtonDown="TabAdd_MouseLeftButtonDown"/>
                </Grid>
                <Border Height="1" VerticalAlignment="Bottom" Margin="8,0" Background="{DynamicResource Grid.Divider}"/>
                <TextBlock x:Name="Chevron" Text="&#x25BE;" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,6,0" Padding="8,2" Background="Transparent" Opacity="0" Cursor="Hand"
                           Foreground="{DynamicResource Grid.TitleText}" ToolTip="{l:T chevron.tip}"
                           MouseLeftButtonDown="Chevron_MouseLeftButtonDown"/>
                <TextBox x:Name="TitleBox" Visibility="Collapsed" Margin="6,3" VerticalContentAlignment="Center"
                         LostFocus="TitleBox_LostFocus" KeyDown="TitleBox_KeyDown"/>
            </Grid>

            <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="Extended"
                     Background="Transparent" BorderThickness="0" Margin="6,4,0,12" AllowDrop="True"
                     ItemContainerStyle="{StaticResource ItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="List_KeyDown"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{DynamicResource Grid.CellWidth}" ToolTip="{Binding Tip}" Opacity="{Binding ItemOpacity}" Loaded="Item_Loaded">
                            <Image Source="{Binding Icon}" Width="{DynamicResource Grid.IconSize}" Height="{DynamicResource Grid.IconSize}"
                                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxHeight="{DynamicResource Grid.LabelMaxHeight}"
                                       FontSize="{DynamicResource Grid.LabelFontSize}"
                                       Foreground="{DynamicResource Grid.Text}" Effect="{DynamicResource Grid.TextEffect}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 重新命名：像檔案總管一樣直接在圖示下方編輯 -->
            <TextBox x:Name="ItemEditBox" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                     TextWrapping="Wrap" TextAlignment="Center" AcceptsReturn="False" MaxHeight="64"
                     LostFocus="ItemEdit_LostFocus" PreviewKeyDown="ItemEdit_KeyDown"/>

            <Border x:Name="DropHint" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="8"
                    BorderBrush="#FF4C9AFF" BorderThickness="2" Background="#224C9AFF">
                <TextBlock x:Name="DropHintText" Text="{l:T drop.add}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Grid.Text}" Effect="{DynamicResource Grid.TextEffect}"/>
            </Border>

            <!-- 4 邊 + 4 角縮放 -->
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="L" Width="5" Margin="0,10"
                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="R" Width="5" Margin="0,10"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="T" Height="5" Margin="10,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top" Cursor="SizeNS"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="B" Height="5" Margin="10,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="LT" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="RT" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Style="{StaticResource EdgeThumb}" Tag="LB" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta"/>
            <Thumb Grid.RowSpan="2" Tag="RB" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M 0,12 L 12,0 L 12,12 Z" Fill="{DynamicResource Grid.Grip}"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
